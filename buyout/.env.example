# Бот «Выкуп и комиссия» — отдельный бот MAX, файл .env кладётся рядом с папкой buyout/
# Токен НОВОГО бота от @MasterBot в MAX (не токен бота метрики!)
BUYOUT_BOT_TOKEN=
# Владелец бота (MAX user_id): получает оповещения, назначает администраторов (/admin_add)
OWNER_USER_ID=4852272
# Дополнительные администраторы через запятую (можно и командой /admin_add)
BUYOUT_ADMIN_IDS=
# Ключ Anthropic API (console.anthropic.com). Пусто — агент не пишет продавцам.
ANTHROPIC_API_KEY=
# Модель и «усилие» агента (low/medium/high)
BUYOUT_MODEL=claude-opus-5-5
BUYOUT_EFFORT=medium
# Как часто проверять площадки (минут) и через сколько часов один раз напомнить молчащему продавцу
BUYOUT_INTERVAL_MIN=10
BUYOUT_FOLLOWUP_HOURS=24
# Часовой пояс браузера и рабочих часов (как у вашего региона)
BUYOUT_TZ=Asia/Yekaterinburg
TZ=Asia/Yekaterinburg
# Свой путь к Chromium (если не ставили через «playwright install chromium»)
BUYOUT_CHROMIUM_PATH=

# --- Битрикс24: карточка клиента в CRM, ссылка — в рабочий чат ---
# Адрес входящего вебхука (Битрикс24 → Разработчикам → Другое → Входящий вебхук, права «CRM»).
# Пусто — Битрикс24 не используется, клиенты приходят только в чат.
BITRIX_WEBHOOK_URL=
# Что создавать: lead — лид, deal — сделка (+ контакт клиента)
BITRIX_ENTITY=lead
# Для сделок: номер воронки (0 — общая). В профиле салона можно свой: bitrix_category=…
BITRIX_DEAL_CATEGORY_ID=0
# Ответственные по умолчанию: ID сотрудников Битрикс24 через запятую (назначаются по очереди).
# Пусто — ответственным будет владелец вебхука. Узнать ID — команда /bitrix_check в боте.
BITRIX_RESPONSIBLE_IDS=
# Источник в карточке Битрикс24 (код из справочника «Источники»; OTHER — «Другое»)
BITRIX_SOURCE_ID=OTHER
