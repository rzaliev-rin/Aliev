# Скопируйте этот файл в .env и заполните реальными значениями.
# Никогда не коммитьте .env и service_account.json в git.

MAX_BOT_TOKEN=токен_от_MasterBot

# base64("email:пароль") служебного аккаунта MaxPoster
MAXPOSTER_API_KEY=ключ_партнёрского_api_maxposter
MAXPOSTER_API_BASE=https://api.maxposter.ru

GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
GOOGLE_SHEET_ID=id_вашей_google_таблицы
GOOGLE_SHEET_TAB=История оценок
# вкладка истории по метрике v2.0 (создаётся сама, если её нет)
GOOGLE_SHEET_TAB_V2=История оценок v2

# MAX user_id владельца (может включать/выключать бота для всех)
OWNER_USER_ID=
# MAX user_id администраторов через запятую
ADMIN_USER_IDS=
# устаревшее: список разрешённых user_id через запятую
ALLOWED_USER_IDS=

# одно напоминание согласующим, если сделка ждёт решения дольше N минут (0 — выключить)
REMINDER_AFTER_MINUTES=60
# в какие часы слать напоминания (время сервера)
REMINDER_HOURS=9-21

# --- расписание (время сервера ЧЧ:ММ; пусто — выключено) ---
# утренняя сводка согласующим
DIGEST_TIME=09:00
# недельный отчёт: день недели (0 — понедельник) и время
REPORT_WEEKDAY=0
REPORT_TIME=09:00
# кому слать недельный отчёт (MAX ID через запятую); пусто — только владельцу
REPORT_USER_IDS=
# резервная копия данных владельцу в MAX и сколько дней хранить копии на сервере
BACKUP_TIME=21:30
BACKUP_KEEP_DAYS=14
# повторная оценка VIN: за сколько дней искать прошлые оценки
DUPLICATE_DAYS=7

# --- поля MaxPoster (заполняются по выводу /raw) ---
MAXPOSTER_APPRAISAL_DATE_FIELD=
AVITO_MAX_AGE_DAYS=3
MAXPOSTER_RECEPTION_FIELD=
MAXPOSTER_RECEPTION_MAP=
MAXPOSTER_AUTOHUB_PTSP_FIELD=
